                    docker_image = utils.buildHipClangJob(needs_gpu:false, needs_reboot:false, needs_cleanup:true, build_install: true, make_targets: "install")
                    withDockerRegistry([ credentialsId: "docker_test_cred", url: "" ]) {
                        docker_image.push()
                    }
                }
            }
        }
